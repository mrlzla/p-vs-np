/-- A guessed circuit certifies MCSP acceptance exactly when the indexed
disagreement test is unsatisfiable. The verifier only reads address bits. -/
theorem mcsp_accept_iff_no_disagreement {m : ℕ} (T : BitString (2^m)) :
    mcspSquare m T = true ↔
      ∃ w : BooleanFunction m, complexity interpretation (single w) ≤ m^2 ∧
        ∀ a, ((MCSP.truthTable m).symm T a ^^ w a) = false := by
  rw [mcspSquare,GapMCSP.slice_yesSet_eq_true_iff]
  constructor
  · intro h
    exact ⟨(MCSP.truthTable m).symm T,h,fun a => Bool.xor_self _⟩
  · rintro ⟨w,hSize,hCheck⟩
    have he : (MCSP.truthTable m).symm T = w := by
      funext a
      have hEq (u v : Bool) : (u ^^ v) = false → u = v := by
        cases u <;> cases v <;> decide
      exact hEq _ _ (hCheck a)
    rwa [he]

/-- When the target table is itself generated by a circuit, the address
test uses one copy of each circuit and four gates for the disagreement. -/
theorem indexed_disagreement_size {m s t : ℕ} (f w : BooleanFunction m)
    (hf : complexity interpretation (single f) ≤ s)
    (hw : complexity interpretation (single w) ≤ t) :
    complexity interpretation (single fun a => f a ^^ w a) ≤ s+t+4 :=
  (complexity_xor_le f w).trans (Nat.add_le_add_right (Nat.add_le_add hf hw) _)

section RankTransfer

variable {I J : Type*} [Fintype I] {n g : ℕ}

/-- Restricting the original paid span to a witness batch gives precisely its
sampled span. The kernel measures all rank hidden by this local verification. -/
theorem paidBatch_rank_split (p : Program signature n g) (base : BitString n)
    (T : I → BitString n) (select : J → I) (paid : Finset (Fin g)) :
    let U := paidBatchSpan p base T paid
    let verify := (restrictRawQuotient base T select).comp U.subtype
    Module.finrank F₂ U = Module.finrank F₂ (paidBatchSpan p base (T ∘ select) paid) +
      Module.finrank F₂ (LinearMap.ker verify) := by
  let U := paidBatchSpan p base T paid
  let L := restrictRawQuotient base T select
  have hMap : U.map L = paidBatchSpan p base (T ∘ select) paid := by
    unfold U paidBatchSpan
    rw [Submodule.map_span, ← Set.range_comp]
    congr 2
  have hRange : LinearMap.range (L.comp U.subtype) = U.map L := by
    ext v
    constructor
    · rintro ⟨⟨z,hz⟩,rfl⟩
      exact Submodule.mem_map.mpr ⟨z,hz,rfl⟩
    · intro hv
      obtain ⟨z,hz,hv⟩ := Submodule.mem_map.mp hv
      exact ⟨⟨z,hz⟩,hv⟩
  have h := (L.comp U.subtype).finrank_range_add_finrank_ker
  rw [hRange,hMap] at h
  exact h.symm

/-- A sampled rank cap and a kernel cap together suffice to charge gates
outside the paid span using the original sparsity argument. -/
theorem outside_rank_from_verifier {k : ℕ} {J : Type*}
    (p : Program signature n g) (pin : Fin n → Fin k ⊕ Bool)
    (a : BitString k) (out : Wire n g) (paid : Finset (Fin g))
    (select : J → (Fin k → F₂)) (B D K : ℕ)
    (hYes : restrictedWire p pin out a = true)
    (hSparse : (acceptingTables (restrictedWire p pin out)).card ≤ 2^B)
    (hCaps :
      let base := substitute pin a
      let T (z : Fin k → F₂) := substitute pin (perturb a z)
      let U := paidBatchSpan p base T paid
      Module.finrank F₂ (paidBatchSpan p base (T ∘ select) paid) ≤ D ∧
        Module.finrank F₂ (LinearMap.ker ((restrictRawQuotient base T select).comp U.subtype)) ≤ K) :
    k-(B+D+K+1) ≤ remainingRank p pin a paid := by
  have hSplit := paidBatch_rank_split p (substitute pin a)
    (fun z => substitute pin (perturb a z)) select paid
  have hUpper : paidRank p pin a paid ≤ D+K := by
    change Module.finrank F₂ (paidBatchSpan p (substitute pin a)
      (fun z => substitute pin (perturb a z)) paid) ≤ _
    exact hSplit.le.trans (Nat.add_le_add hCaps.1 hCaps.2)
  have hLower := remainingRank_lower_of_sparse p pin a out paid B hYes hSparse
  omega

end RankTransfer

section SingleEntry

variable {n g : ℕ}

/-- Flip one free entry of the center, or use the center itself. -/
def oneEntry (base : BitString n) (P : Finset (Fin n)) (j : Option (Fin n)) (i : Fin n) : Bool :=
  base i ^^ decide (j = some i ∧ i ∉ P)

private theorem oneEntry_none (base : BitString n) (P : Finset (Fin n)) :
    oneEntry base P none = base := by
  funext i
  simp [oneEntry]

private theorem oneEntry_some_pinned (base : BitString n) (P : Finset (Fin n)) (i : Fin n) (hi : i ∈ P) :
    oneEntry base P (some i) = base := by
  funext t
  by_cases h : i = t
  · subst t
    simp [oneEntry, hi]
  · simp [oneEntry, h]

private theorem raw_oneEntry (base : BitString n) (P : Finset (Fin n)) (i : Fin n) (hi : i ∉ P) :
    raw base (oneEntry base P) i = Pi.single (some i) (1 : F₂) := by
  funext q
  by_cases hq : q = some i
  · subst q
    cases h : base i <;> simp [raw,oneEntry,hi,bit,h]
  · simp [raw,oneEntry,hq,bit]

/-- Every free coordinate has its own query. On these locally verified
witnesses the raw traces nevertheless account for every gate trace. -/
theorem oneEntry_paidSpan_eq_bot (p : Program signature n g)
    (base : BitString n) (P : Finset (Fin n)) (paid : Finset (Fin g)) :
    paidBatchSpan p base (oneEntry base P) paid = ⊥ := by
  let T := oneEntry base P
  let U := rawSpan base T
  have hCentered (w : Wire n g) : centered p base T w ∈ U := by
    let f := centered p base T w
    have hZero : f none = 0 := by
      change bit ((p.trace interpretation base w) ^^ (p.trace interpretation (oneEntry base P none) w)) = 0
      rw [oneEntry_none]
      simp [bit]
    have hPin (i : Fin n) (hi : i ∈ P) : f (some i) = 0 := by
      change bit ((p.trace interpretation base w) ^^ (p.trace interpretation (oneEntry base P (some i)) w)) = 0
      rw [oneEntry_some_pinned base P i hi]
      simp [bit]
    have he : f = ∑ i ∈ (Finset.univ \ P), f (some i) • raw base T i := by
      funext q
      rw [Finset.sum_apply]
      cases q with
      | none =>
        rw [hZero]
        symm
        apply Finset.sum_eq_zero
        intro i hi
        have hn := (Finset.mem_sdiff.mp hi).2
        simp [T,raw_oneEntry base P i hn]
      | some j =>
        by_cases hj : j ∈ P
        · rw [hPin j hj]
          symm
          apply Finset.sum_eq_zero
          intro i hi
          have hn := (Finset.mem_sdiff.mp hi).2
          have hne : j ≠ i := fun h => hn (h ▸ hj)
          simp [T,raw_oneEntry base P i hn,hne]
        · symm
          rw [Finset.sum_eq_single j]
          · simp [T,raw_oneEntry base P j hj]
          · intro i hi hij
            have hn := (Finset.mem_sdiff.mp hi).2
            simp [T,raw_oneEntry base P i hn,Ne.symm hij]
          · exact fun hn => (hn (Finset.mem_sdiff.mpr ⟨Finset.mem_univ _,hj⟩)).elim
    change f ∈ U
    rw [he]
    exact Submodule.sum_mem U fun i _ => U.smul_mem _ (Submodule.subset_span ⟨i,rfl⟩)
  apply le_antisymm _ bot_le
  apply Submodule.span_le.mpr
  rintro _ ⟨j,rfl⟩
  change U.mkQ (centered p base T (.gate j.val)) = 0
  exact LinearMap.mem_ker.mp (by rw [Submodule.ker_mkQ]; exact hCentered _)

set_option maxRecDepth 1800 in
/-- A one-point exception is a prefix test followed by a single NOT. -/
theorem oneEntry_witness_size32 (P : Finset (Fin (2^32))) (j : Option (Fin (2^32))) :
    complexity interpretation (single ((MCSP.truthTable 32).symm
      (oneEntry (fun _ => true) P j))) ≤ 66 := by
  have hc : complexity interpretation (single (fun _ : BitString 32 => true)) ≤ 66 :=
    (Boolean.complexity_const (n := 32) true).le.trans (by decide)
  have hec : (MCSP.truthTable 32).symm (fun _ => true) = fun _ => true := rfl
  cases j with
  | none => rw [oneEntry_none, hec]; exact hc
  | some i =>
    by_cases hi : i ∈ P
    · rw [oneEntry_some_pinned (fun _ => true) P i hi, hec]; exact hc
    let z := (BitString.equivFin 32).symm i
    let G : BooleanFunction 32 := fun a => !prefixMatch (d := 0) z a
    have hS : Synthesis interpretation (inputs 32) {G} (2*32+1+1) :=
      (synthesis_prefix_match (d := 0) z).not
    have he : MCSP.truthTable 32 G = oneEntry (fun _ => true) P (some i) := by
      funext t
      rw [MCSP.truthTable_apply]
      have hAddress : addressHead (a := 32) 0 ((BitString.equivFin 32).symm t) =
          (BitString.equivFin 32).symm t := by
        funext k
        apply congrArg ((BitString.equivFin 32).symm t)
        exact Fin.ext rfl
      change (!decide (addressHead 0 ((BitString.equivFin 32).symm t) = z)) = _
      rw [hAddress]
      have ht : ((BitString.equivFin 32).symm t = z) ↔ t = i := (BitString.equivFin 32).symm.injective.eq_iff
      by_cases he : t = i
      · subst t
        simp [z,oneEntry,hi]
      · have hne : i ≠ t := Ne.symm he
        simp [oneEntry,ht,he,hne]
    rw [← he,Equiv.symm_apply_apply]
    exact hS.complexity_le

theorem mcsp32_accepts_oneEntry (P : Finset (Fin (2^32))) (j : Option (Fin (2^32))) :
    mcspSquare 32 (oneEntry (fun _ => true) P j) = true := by
  rw [mcspSquare,GapMCSP.slice_yesSet_eq_true_iff]
  exact (oneEntry_witness_size32 P j).trans (by decide)

/-- The same exact recognizer can contain an AND tree carrying a nearly
full rank on the cube, even though every single-entry query is accepted
and the sampled rank of that very tree is zero. -/
theorem mcsp32_oneEntry_rank_control (P : Finset (Fin (2^32))) (hP : P.card < 2^32) :
    ∃ (c : Circuit signature (2^32) 1) (paid : Finset (Fin c.size)),
      c.Computes interpretation (single (mcspSquare 32)) ∧
      c.size ≤ complexity interpretation (single (mcspSquare 32))+2^32 ∧
      (∀ j, mcspSquare 32 (oneEntry (fun _ => true) P j) = true) ∧
      paidBatchSpan c.program (fun _ => true) (oneEntry (fun _ => true) P) paid = ⊥ ∧
      2^32-P.card-1 ≤ paidRank c.program (pinAt (fun _ => true) P) (fun _ => true) paid := by
  obtain ⟨c,gate,hc,hSize,hTrace⟩ := same_recognizer_with_comb
    (by decide : 2 ≤ (2:ℕ)^32) (mcspSquare_constant_table 32 (by decide) true)
  let paid := ((Finset.univ : Finset (Fin (2^32))).filter fun i => 0 < i.val).image gate
  exact ⟨c,paid,hc,hSize,mcsp32_accepts_oneEntry P,oneEntry_paidSpan_eq_bot c.program (fun _ => true) P paid,
    comb_paidRank_lower c.program gate hTrace P hP⟩

/-- One perturbation coordinate is enough to access each witness in this batch. -/
def oneEntryLabel (j : Option (Fin n)) : Fin n → F₂ :=
  j.elim 0 (fun i => Pi.single i 1)

theorem oneEntry_on_restriction (x a : BitString n) (P : Finset (Fin n)) :
    ((fun z => substitute (pinAt x P) (perturb a z)) ∘ oneEntryLabel) =
      oneEntry (substitute (pinAt x P) a) P := by
  funext j i
  by_cases hi : i ∈ P
  · simp [oneEntry,substitute,pinAt,hi]
  · cases j with
    | none => simp [oneEntryLabel,oneEntry,substitute,pinAt,hi,perturb]
    | some t =>
      by_cases he : t = i
      · subst t
        simp [oneEntryLabel,oneEntry,substitute,pinAt,hi,perturb]
      · simp [oneEntryLabel,oneEntry,substitute,pinAt,hi,perturb,he,Ne.symm he]

/-- The rank hidden from all single-entry checks is exactly the full paid rank. -/
theorem oneEntry_kernel_eq_paidRank (p : Program signature n g) (x a : BitString n)
    (P : Finset (Fin n)) (paid : Finset (Fin g)) :
    let pin := pinAt x P
    let base := substitute pin a
    let T (z : Fin n → F₂) := substitute pin (perturb a z)
    let U := paidBatchSpan p base T paid
    Module.finrank F₂ (LinearMap.ker ((restrictRawQuotient base T oneEntryLabel).comp U.subtype)) =
      paidRank p pin a paid := by
  have h := paidBatch_rank_split p (substitute (pinAt x P) a)
    (fun z => substitute (pinAt x P) (perturb a z)) oneEntryLabel paid
  have hSample : Module.finrank F₂ (paidBatchSpan p (substitute (pinAt x P) a)
      ((fun z => substitute (pinAt x P) (perturb a z)) ∘ oneEntryLabel) paid) = 0 := by
    rw [oneEntry_on_restriction, oneEntry_paidSpan_eq_bot, finrank_bot]
  dsimp only at h
  rw [hSample,zero_add] at h
  exact h.symm

/-- Under arbitrary block pins, all single-entry queries around the repaired
all-one table still have short MCSP witnesses. -/
theorem mcsp32_repaired_oneEntry (q : BitString 22) (x : BitString (2^32))
    (j : Option (Fin (2^32))) :
    mcspSquare 32 (oneEntry (substitute (pinAt x (block (d := 10) q)) (fun _ => true))
      (block (d := 10) q) j) = true := by
  let P := block (d := 10) q
  let T := oneEntry (fun _ => true) P j
  let f := (MCSP.truthTable 32).symm T
  have hF : MCSP.truthTable 32 f = T := (MCSP.truthTable 32).apply_symm_apply T
  have he : oneEntry (substitute (pinAt x P) (fun _ => true)) P j =
      substitute (pinAt x P) T := by
    funext i
    by_cases hi : i ∈ P <;> simp [T,oneEntry,substitute,pinAt,hi]
  rw [he,← hF]
  exact accepted_after_1024_pin q x f ((oneEntry_witness_size32 P j).trans (by decide))

set_option maxRecDepth 1800 in
/-- The near-minimum exact circuit selected by the forest argument has a
sparse repair with a zero sampled forest span. On the same restriction the
full trace rank still obeys the original sparsity lower bound. -/
theorem mcsp32_actual_forest_witness_slice (c : Circuit signature (2^32) 1)
    (hc : c.Computes interpretation (single (mcspSquare 32))) (hSize : c.size ≤ 8630810218) :
    ∃ (q : BitString 22) (x : BitString (2^32)) (R : Finset (Fin c.size)),
      let P := block (d := 10) q
      let pin := pinAt x P
      let a : BitString (2^32) := fun _ => true
      let base := substitute pin a
      let paid := cleanGates c.program (c.outputs 0)
      200 ≤ R.card ∧ R ⊆ paid ∧
      (∀ j ∈ R, ∃ b : Bool, restrictedWire c.program pin (.gate j) = fun _ => b) ∧
      (∀ j, mcspSquare 32 (oneEntry base P j) = true) ∧
      paidBatchSpan c.program base (oneEntry base P) paid = ⊥ ∧
      4294948391 ≤ pinRank c.program pin a := by
  obtain ⟨q,x,R,b,_,hSparse,hCard,_,hSub,hConst⟩ := mcsp32_actual_forest_absorption c hc hSize
  let P := block (d := 10) q
  let pin := pinAt x P
  let a : BitString (2^32) := fun _ => true
  let root := c.outputs 0
  have hYes : restrictedWire c.program pin root a = true := by
    rw [restricted_circuit_eq c hc pin]
    simpa only [oneEntry_none] using mcsp32_repaired_oneEntry q x none
  have hCount : (acceptingTables (restrictedWire c.program pin root)).card ≤ 2^(18904 : ℕ) := by
    rw [restricted_circuit_eq c hc pin]
    exact hSparse
  have hFull := pinRank_lower c.program pin a root 18904 hYes hCount
  change 4294967296 ≤ _ at hFull
  have hLower : 4294948391 ≤ pinRank c.program pin a := by
    clear hCount hSparse
    omega
  exact ⟨q,x,R,hCard,hSub,fun j hj => ⟨b,hConst j hj⟩,mcsp32_repaired_oneEntry q x,
    oneEntry_paidSpan_eq_bot c.program (substitute pin a) P _,hLower⟩

end SingleEntry

section QuadraticWitnesses

open PolynomialBarrier

private def toBool (v : F₂) : Bool := decide (v = 1)

private theorem toBool_bit (b : Bool) : toBool (bit b) = b := by cases b <;> decide

private theorem bit_toBool (v : F₂) : bit (toBool v) = v := by
  fin_cases v <;> rfl

private theorem toBool_add (u v : F₂) : toBool (u + v) = (toBool u ^^ toBool v) := by
  fin_cases u <;> fin_cases v <;> decide

private def degreeTwoSpace (m : ℕ) : Submodule F₂ (BitString m → F₂) where
  carrier := {v | isDegFn 2 m (fun a => toBool (v a)) = true}
  zero_mem' := isDegFn_const 2 m (toBool 0)
  add_mem' := by
    intro u v hu hv
    change isDegFn 2 m (fun a => toBool (u a + v a)) = true
    simpa only [toBool_add] using isDegFn_xor hu hv
  smul_mem' := by
    intro c v hv
    fin_cases c
    · change isDegFn 2 m (fun a => toBool ((0 : F₂) • v a)) = true
      simpa only [zero_smul] using (isDegFn_const 2 m (toBool 0))
    · change isDegFn 2 m (fun a => toBool ((1 : F₂) • v a)) = true
      rw [show (fun a => toBool ((1 : F₂) • v a)) = (fun a => toBool (v a)) from
        funext fun a => by rw [one_smul]]
      exact hv

private theorem degreeTwoSpace_finrank (m : ℕ) :
    Module.finrank F₂ (degreeTwoSpace m) = rmDim 2 m := by
  let S := Finset.univ.filter (fun f : BooleanFunction m => isDegFn 2 m f = true)
  let E : degreeTwoSpace m ≃ S :=
    { toFun := fun v => ⟨fun a => toBool (v.val a),
        Finset.mem_filter.mpr ⟨Finset.mem_univ _,v.property⟩⟩
      invFun := fun f => ⟨fun a => bit (f.val a), by
        change isDegFn 2 m (fun a => toBool (bit (f.val a))) = true
        simpa only [toBool_bit] using (Finset.mem_filter.mp f.property).2⟩
      left_inv := fun v => Subtype.ext (funext fun a => bit_toBool (v.val a))
      right_inv := fun f => Subtype.ext (funext fun a => toBool_bit (f.val a)) }
  have h := Fintype.card_congr E
  rw [Module.card_eq_pow_finrank (K := F₂),ZMod.card,Fintype.card_coe] at h
  exact Nat.pow_right_injective (by decide : 2 ≤ 2) (h.trans (card_isDegFn 2 m))

/-- Raw coordinates on a common pinning of quadratic witnesses all factor
through the dual of the degree-two address space. -/
private theorem quadratic_raw_profiles {m : ℕ} {I : Type*} [Fintype I]
    (x : BitString (2^m)) (P : Finset (Fin (2^m))) (center : BooleanFunction m)
    (F : I → BooleanFunction m) (hCenter : isDegFn 2 m center = true)
    (hF : ∀ i, isDegFn 2 m (F i) = true) :
    let base := substitute (pinAt x P) (MCSP.truthTable m center)
    let T (i : I) := substitute (pinAt x P) (MCSP.truthTable m (F i))
    ∃ V : Submodule F₂ (I → F₂), Module.finrank F₂ V ≤ rmDim 2 m ∧
      ∀ j, raw base T j ∈ V := by
  let base := substitute (pinAt x P) (MCSP.truthTable m center)
  let T (i : I) := substitute (pinAt x P) (MCSP.truthTable m (F i))
  let W := degreeTwoSpace m
  let differences (i : I) : W := ⟨fun a => bit (center a ^^ F i a), by
    change isDegFn 2 m (fun a => toBool (bit (center a ^^ F i a))) = true
    simpa only [toBool_bit] using isDegFn_xor hCenter (hF i)⟩
  let eval : Module.Dual F₂ W →ₗ[F₂] (I → F₂) :=
    { toFun := fun l i => l (differences i)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  refine ⟨LinearMap.range eval, ?_, ?_⟩
  · have hd := eval.finrank_range_le
    rwa [Subspace.dual_finrank_eq, degreeTwoSpace_finrank] at hd
  · intro j
    by_cases hj : j ∈ P
    · have he : raw base T j = 0 := by funext i; simp [raw,base,T,pinAt,hj,bit]
      rw [he]
      exact (LinearMap.range eval).zero_mem
    · refine ⟨(LinearMap.proj ((BitString.equivFin m).symm j)).comp W.subtype, ?_⟩
      funext i
      simp [eval,differences,raw,substitute,pinAt,hj,MCSP.truthTable_apply]

private theorem product_space_finrank {I : Type*} [Fintype I]
    (V : Submodule F₂ (I → F₂)) :
    Module.finrank F₂ (V * V) ≤ Module.finrank F₂ V * Module.finrank F₂ V := by
  let b := Module.finBasis F₂ V
  let u (i : Fin (Module.finrank F₂ V)) : I → F₂ := (b i).val
  have hSpan : Submodule.span F₂ (Set.range u) = V := by
    change Submodule.span F₂ (Set.range (V.subtype ∘ b)) = V
    rw [Set.range_comp, Submodule.span_image, b.span_eq, Submodule.map_subtype_top]
  let pair (t : Fin (Module.finrank F₂ V) × Fin (Module.finrank F₂ V)) := u t.1 * u t.2
  have hPairs : Set.range pair = Set.range u * Set.range u := by
    ext w
    rw [Set.mem_mul]
    constructor
    · rintro ⟨⟨i,j⟩,rfl⟩
      exact ⟨u i,⟨i,rfl⟩,u j,⟨j,rfl⟩,rfl⟩
    · rintro ⟨_,⟨i,rfl⟩,_,⟨j,rfl⟩,rfl⟩
      exact ⟨(i,j),rfl⟩
  calc
    _ = Module.finrank F₂ (Submodule.span F₂ (Set.range pair)) := by
      rw [hPairs,← Submodule.span_mul_span,hSpan]
    _ ≤ _ := (finrank_range_le_card pair).trans_eq (by simp only [Fintype.card_prod, Fintype.card_fin])

private theorem paid_rank_le_raw_products {I : Type*} [Fintype I] {n g : ℕ}
    (p : Program signature n g) (base : BitString n) (T : I → BitString n)
    (paid : Finset (Fin g)) (V : Submodule F₂ (I → F₂))
    (hRaw : ∀ i, raw base T i ∈ V)
    (hRead : ∀ j ∈ paid, ∀ a, ∃ i : Fin n, (p.lines j).wires a = .input i) :
    Module.finrank F₂ (paidBatchSpan p base T paid) ≤
      Module.finrank F₂ V * Module.finrank F₂ V := by
  let U := rawSpan base T
  let S := (V * V).map U.mkQ
  have hSub : paidBatchSpan p base T paid ≤ S := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j,rfl⟩
    change centered p base T (.gate j.val) ∈ S.comap U.mkQ
    have hPort (a : Fin (signature.Arity (p.lines j.val).op)) :
        ∃ i, centered p base T ((p.lines j.val).wires a) = raw base T i := by
      obtain ⟨i,hi⟩ := hRead j.val j.property a
      exact ⟨i,by rw [hi]; rfl⟩
    have hP : interaction p base T j.val ∈ V*V := by
      have hProd (op : Op) (F : Fin (signature.Arity op) → I → F₂) (h : ∀ a, F a ∈ V) :
          gateProduct op F ∈ V*V := by
        cases op
        · exact (V*V).zero_mem
        · exact (V*V).zero_mem
        · exact Submodule.mul_mem_mul (h 0) (h 1)
        · exact Submodule.mul_mem_mul (h 0) (h 1)
      apply hProd
      intro a
      obtain ⟨i,hi⟩ := hPort a
      rw [hi]
      exact hRaw i
    have hQ : interaction p base T j.val ∈ S.comap U.mkQ :=
      Submodule.mem_map.mpr ⟨_,hP,rfl⟩
    unfold centered at *
    simp only [p.trace_gate]
    apply gate_centered_mem _ _ _ _ ?_ hQ
    intro a
    obtain ⟨i,hi⟩ := hPort a
    rw [hi]
    change U.mkQ (raw base T i) ∈ S
    have hZero : U.mkQ (raw base T i) = 0 := LinearMap.mem_ker.mp (by
      rw [Submodule.ker_mkQ]
      exact Submodule.subset_span ⟨i,rfl⟩)
    rw [hZero]
    exact S.zero_mem
  exact (Submodule.finrank_mono hSub).trans ((Submodule.finrank_map_le U.mkQ (V*V)).trans (product_space_finrank V))

/-- On all repaired rank-one quadratic probes, every subfamily of the
original forest whose gates read raw inputs has rank at most 529²
modulo the raw profiles. Pins may be chosen by the forest itself. -/
theorem mcsp32_raw_forest_quadratic_rank {g : ℕ} (p : Program signature (2^32) g)
    (q : BitString 22) (x : BitString (2^32)) (paid : Finset (Fin g))
    (hRead : ∀ j ∈ paid, ∀ a, ∃ i : Fin (2^32), (p.lines j).wires a = .input i) :
    let P := block (d := 10) q
    let base := substitute (pinAt x P) (fun _ => true)
    let T (u : (BitString 32 × Bool) × (BitString 32 × BitString 32)) :=
      substitute (pinAt x P) (MCSP.truthTable 32 (quad u.1.1 u.1.2 u.2.1 u.2.2))
    (∀ u, mcspSquare 32 (T u) = true) ∧
      Module.finrank F₂ (paidBatchSpan p base T paid) ≤ 279841 := by
  let P := block (d := 10) q
  let center : BooleanFunction 32 := fun _ => true
  let F (u : (BitString 32 × Bool) × (BitString 32 × BitString 32)) :=
    quad u.1.1 u.1.2 u.2.1 u.2.2
  obtain ⟨V,hDim,hRaw⟩ := quadratic_raw_profiles x P center F (isDegFn_const 2 32 true)
    (fun u => isDegFn_two_quad 32 u.1.1 u.1.2 u.2.1 u.2.2)
  have h529 : rmDim 2 32 = 529 := by rw [rmDim_two]; decide
  rw [h529] at hDim
  refine ⟨fun u => accepted_after_1024_pin q x (F u) (complexity_quad_shared_le ..), ?_⟩
  exact (paid_rank_le_raw_products p _ _ paid V hRaw hRead).trans (Nat.mul_le_mul hDim hDim)

private theorem paid_rank_partition {I : Type*} [Fintype I] {n g : ℕ}
    (p : Program signature n g) (base : BitString n) (T : I → BitString n)
    (paid covered absorbed : Finset (Fin g))
    (hZero : ∀ j ∈ absorbed, centered p base T (.gate j) = 0) :
    Module.finrank F₂ (paidBatchSpan p base T paid) ≤
      Module.finrank F₂ (paidBatchSpan p base T covered) + (paid \ (covered ∪ absorbed)).card := by
  let U := rawSpan base T
  let left := paidBatchSpan p base T covered
  let rest := paid \ (covered ∪ absorbed)
  let right := paidBatchSpan p base T rest
  have hLeft : left ≤ left ⊔ right := le_sup_left
  have hRightSub : right ≤ left ⊔ right := le_sup_right
  have hSub : paidBatchSpan p base T paid ≤ left ⊔ right := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j,rfl⟩
    by_cases hc : j.val ∈ covered
    · exact hLeft (Submodule.subset_span ⟨⟨j.val,hc⟩,rfl⟩)
    by_cases ha : j.val ∈ absorbed
    · change U.mkQ (centered p base T (.gate j.val)) ∈ left ⊔ right
      rw [hZero _ ha,map_zero]
      exact (left ⊔ right).zero_mem
    · have hr : j.val ∈ rest :=
        Finset.mem_sdiff.mpr ⟨j.property,fun h => (Finset.mem_union.mp h).elim hc ha⟩
      exact hRightSub (Submodule.subset_span ⟨⟨j.val,hr⟩,rfl⟩)
  have hSum := Submodule.finrank_add_le_finrank_add_finrank (K := F₂) (V := _) left right
  have hRight : Module.finrank F₂ right ≤ rest.card :=
    (finrank_range_le_card (fun j : rest => U.mkQ (centered p base T (.gate j.val)))).trans_eq
      (Fintype.card_coe _)
  exact (Submodule.finrank_mono hSub).trans (hSum.trans (Nat.add_le_add_left hRight _))

/-- Keep both the absorbed roots and the shared raw-fed trace space in the
actual forest budget. The remaining gates are each charged at most once. -/
theorem mcsp32_actual_forest_quadratic_budget (c : Circuit signature (2^32) 1)
    (hc : c.Computes interpretation (single (mcspSquare 32))) (hSize : c.size ≤ 8630810218) :
    ∃ (q : BitString 22) (x : BitString (2^32)) (absorbed : Finset (Fin c.size)),
      let pin := pinAt x (block (d := 10) q)
      let base := substitute pin (fun _ => true)
      let T (u : (BitString 32 × Bool) × (BitString 32 × BitString 32)) :=
        substitute pin (MCSP.truthTable 32 (quad u.1.1 u.1.2 u.2.1 u.2.2))
      let paid := cleanGates c.program (c.outputs 0)
      let rawFed := paid.filter fun j =>
        ∀ a, ∃ i : Fin (2^32), (c.program.lines j).wires a = .input i
      200 ≤ absorbed.card ∧ absorbed ⊆ paid ∧
      (∀ j ∈ absorbed, ∃ b : Bool, restrictedWire c.program pin (.gate j) = fun _ => b) ∧
      (∀ u, mcspSquare 32 (T u) = true) ∧
      Module.finrank F₂ (paidBatchSpan c.program base T paid) ≤
        279841 + (paid \ (rawFed ∪ absorbed)).card := by
  obtain ⟨q,x,R,b,_,_,hCard,_,hSub,hConst⟩ := mcsp32_actual_forest_absorption c hc hSize
  let p := c.program
  let pin := pinAt x (block (d := 10) q)
  let base := substitute pin (fun _ => true)
  let T (u : (BitString 32 × Bool) × (BitString 32 × BitString 32)) :=
    substitute pin (MCSP.truthTable 32 (quad u.1.1 u.1.2 u.2.1 u.2.2))
  let paid := cleanGates p (c.outputs 0)
  let rawFed := paid.filter fun j => ∀ a, ∃ i : Fin (2^32), (p.lines j).wires a = .input i
  have hRead : ∀ j ∈ rawFed, ∀ a, ∃ i : Fin (2^32), (p.lines j).wires a = .input i :=
    fun _ hj => (Finset.mem_filter.mp hj).2
  obtain ⟨hAccept,hRank⟩ := mcsp32_raw_forest_quadratic_rank p q x rawFed hRead
  have hZero (j : Fin c.size) (hj : j ∈ R) : centered p base T (.gate j) = 0 := by
    funext u
    change bit (restrictedWire p pin (.gate j) (fun _ => true) ^^
      restrictedWire p pin (.gate j) (MCSP.truthTable 32 (quad u.1.1 u.1.2 u.2.1 u.2.2))) = 0
    rw [hConst j hj]
    simp [bit]
  refine ⟨q,x,R,hCard,hSub,fun j hj => ⟨b,hConst j hj⟩,hAccept,?_⟩
  exact (paid_rank_partition p base T paid rawFed R hZero).trans (Nat.add_le_add_right hRank _)

